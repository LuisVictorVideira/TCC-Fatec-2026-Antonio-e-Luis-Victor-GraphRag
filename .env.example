# Copie este arquivo para .env, na raiz do repositorio, e preencha os valores.
# O .env fica fora do controle de versao (ver .gitignore).

# Neo4j. O docker-compose.yml cria o usuario neo4j com esta senha na primeira
# subida do conteiner; o Neo4j exige 8 caracteres ou mais. Os scripts recusam
# o valor change_me.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me
NEO4J_DATABASE=neo4j

# Pasta que contem relational-databases/ e t-sql/. O scripts/obter_corpus.sh
# cria a pasta corpus/ na raiz do repositorio; o caminho relativo vale para
# comandos rodados a partir da raiz.
SQL_DOCS_ROOT=corpus

# Ollama, para as respostas (responder.py) e a extracao de relacoes
# (extrair_relacoes.py).
OLLAMA_URL=http://localhost:11434

# Opcional: so para a busca vetorial (baselines.py indexar-vetores e vetorial),
# implementada e nao executada no artigo. Sobe com:
#   docker compose --profile vetorial up -d
# PG_HOST=localhost
# PG_PORT=5433
# PG_USER=postgres
# PG_PASSWORD=
# PG_DATABASE=graphrag
